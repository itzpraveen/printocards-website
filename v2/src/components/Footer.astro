---
<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <img src={asset("/brand/printo-logo-light.svg")} alt="Printo Cards & Technologies" width="142" height="48" />
      <p>PVC, ID and smart card manufacturer in Calicut, Kerala. ISO 9001:2015 certified.</p>
      <a class="footer-cat" href={asset("/printo-product-catalogue.pdf")}>Download the catalogue (PDF, 6 MB)</a>
    </div>
    <div>
      <b>Products</b>
      <ul>{families.map((f) => <li><a href="#products">{f.name}</a></li>)}</ul>
    </div>
    <div>
      <b>Industries</b>
      <ul>{industries.map((i) => <li><a href="#industries">{i.name}</a></li>)}</ul>
    </div>
    <div>
      <b>Visit</b>
      <address>
        {contact.officeAddress.lines.map((l) => <span>{l}</span>)}
        <span class="gap">Factory: {contact.factoryAddress.lines[0]}</span>
        {contact.factoryAddress.lines.slice(1).map((l) => <span>{l}</span>)}
      </address>
      <p><a href={`tel:${contact.office.tel}`}>{contact.office.display}</a><br /><a href={`mailto:${contact.emails[0]}`}>{contact.emails[0]}</a></p>
    </div>
    <div>
      <b>Connect</b>
      <ul class="social">
        {connect.map((c) => (
          <li><a href={c.href} {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[c.name]} /></svg>{c.name}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="wrap footer-base">
    <span>© 2026 Printo Cards &amp; Technologies</span>
    <span>Printer brands are named as products we supply.</span>
  </div>
</footer>

<aside class="sticky-bar" data-sticky-bar aria-label="Quick contact">
  <a class="btn btn-dark" href={waLink('Hi Printo, I would like a quote for cards.')} target="_blank" rel="noopener"><svg class="wa" viewBox="0 0 24 24" aria-hidden="true"><path d={WA} /></svg>Get a quote</a>
  <a class="btn btn-light" href={`tel:${contact.office.tel}`}>Call</a>
</aside>
