---
import { waLink, productCount } from '../data/site';
const wa = waLink('Hi Printo, I would like a quote for cards.');
---
<section class="hero" id="top" data-hero>
  <div class="hero-glow" aria-hidden="true"></div>

  <!-- Static stand-in: shown before WebGL is ready, and instead of it with reduced motion -->
  <div class="hero-fallback" aria-hidden="true">
    <svg class="hf-lanyard" viewBox="0 0 300 260" preserveAspectRatio="xMidYMin meet">
      <path d="M90 -10 L143 222" stroke="#373435" stroke-width="30" />
      <path d="M220 -10 L163 222" stroke="#2b2728" stroke-width="30" />
      <rect x="140" y="206" width="26" height="30" rx="5" fill="#b9b9b6" />
    </svg>
    <div class="hf-card">
      <div class="hf-band"><img src="/brand/printo-logo-light.svg" alt="" /></div>
      <div class="hf-stripe"></div>
      <div class="hf-photo"></div>
      <div class="hf-who"><b>Anjali Menon</b><span>Production team</span></div>
      <div class="hf-bar"></div>
    </div>
  </div>

  <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
  <p class="hero-hint" data-hero-hint aria-hidden="true">Drag the card</p>

  <div class="hero-copy wrap">
    <p class="hero-kicker">Get your card customised</p>
    <!-- Headline kept word for word from the current printocards.com -->
    <h1 class="hero-poster display" data-press="112"><span>Biggest PVC Cards</span> <span>Manufacturer in Kerala.</span></h1>
    <p class="hero-lede">We make PVC, ID and smart cards in our own factory, and supply lanyards, accessories and card printers from Calicut to offices, schools, hospitals, hotels and events.</p>
    <div class="ctas">
      <a class="btn btn-dark" href={wa} target="_blank" rel="noopener">
        <svg class="wa" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.4 14.2c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .3-3.3-.7a11.4 11.4 0 0 1-4.5-4c-.4-.5-1.1-1.6-1.1-3s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c0 .2.1.4 0 .6l-.4.6-.5.5c-.2.2-.3.4-.1.7.2.4.8 1.4 1.8 2.3 1.3 1.1 2.3 1.5 2.7 1.6.3.2.5.1.7-.1l1-1.2c.2-.3.4-.3.7-.2l2 1c.3.1.5.2.6.3 0 .2 0 .8-.2 1.3Z"/></svg>
        Get a quote on WhatsApp
      </a>
      <a class="btn btn-ghost" href="#products">See all {productCount} products</a>
    </div>
  </div>

  <div class="hero-foot wrap">
    <ul class="facts">
      <li>ISO 9001:2015 certified</li>
      <li>16+ years of card printing</li>
      <li>Own factory at Omanoor</li>
    </ul>
    <a class="scrollcue" href="#how-cards-are-made">Follow a card
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="13" cy="13" r="7"/><path d="M13 1v24M1 13h24"/></svg>
    </a>
  </div>
</section>
