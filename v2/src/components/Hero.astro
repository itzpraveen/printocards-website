---
import { asset } from '../data/url';
import { waLink, productCount, WA } from '../data/site';
const wa = waLink('Hi Printo, I would like a quote for cards.');
---
<section class="hero" id="top" data-hero>
  <div class="hero-glow" aria-hidden="true"></div>

  <!-- The first paint shows the real badge artwork as a still. The 3D card starts on the first
       interaction and places itself exactly over this still, then crossfades in. -->
  <div class="hero-still" aria-hidden="true">
    <svg class="hs-straps" viewBox="0 0 4.4 100" preserveAspectRatio="none">
      <polygon points="3.57,0 2.83,0 1.95,100 2.69,100" fill="#2b2728" />
      <polygon points="0.83,0 1.57,0 2.45,100 1.71,100" fill="#373435" />
    </svg>
    <span class="hs-clip"></span>
    <img class="hs-card" data-hero-card src={asset("/images/badge-front.webp")} srcset={`${asset("/images/badge-front-360.webp")} 360w, ${asset("/images/badge-front.webp")} 640w`} sizes="(max-width: 760px) 36vw, 24vh" alt="" width="640" height="1019" fetchpriority="high" />
  </div>

  <!-- The client's 20-years emblem (2026-11-09, in place of the logo), printed onto a blank white
       card as the page opens. Its orange ribbon needs a white surface on the orange hero, and a
       printed card is what Printo makes. Shown at every size, phones included (2026-11-13). -->
  <div class="hero-brand" aria-hidden="true">
    <div class="hb-float">
      <div class="hb-card">
        <div class="hb-print"><img src={asset("/brand/printo-20-years.webp")} srcset={`${asset("/brand/printo-20-years-520.webp")} 520w, ${asset("/brand/printo-20-years.webp")} 1000w`} sizes="(max-width: 760px) 30vw, 25vh" alt="" width="1000" height="737" loading="lazy" decoding="async" /></div>
        <span class="hb-head"></span>
        <span class="hb-sheen"></span>
      </div>
    </div>
  </div>

  <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
  <p class="hero-hint" data-hero-hint aria-hidden="true">Drag the card</p>

  <div class="hero-copy wrap">
    <h1 class="hero-title">
      <span class="hero-poster display" data-press>End-to-end card solutions.</span>
      <span class="hero-sub">Biggest PVC card manufacturer &amp; card printer dealers in Kerala</span>
    </h1>
    <div class="hero-row">
      <p class="hero-lede">PVC ID &amp; all types of smart cards, lanyards manufactured in our own facility. Accessories, card printers &amp; consumables all under one roof. Manufactured in Calicut. Supplied across India and around the world.</p>
    <div class="ctas">
      <a class="btn btn-dark" href={wa} target="_blank" rel="noopener">
        <svg class="wa" viewBox="0 0 24 24" aria-hidden="true"><path d={WA} /></svg>
        Get a quote on WhatsApp
      </a>
      <a class="btn btn-ghost" href="#products">See all {productCount} products</a>
    </div>
    </div>
  </div>

  <div class="hero-foot wrap">
    <ul class="facts">
      <li>ISO 9001:2015 certified</li>
      <li>20+ years of card printing</li>
      <li>10,000 sq ft own factory</li>
    </ul>
    <a class="scrollcue" href="#how-cards-are-made">Follow a card
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="13" cy="13" r="7"/><path d="M13 1v24M1 13h24"/></svg>
    </a>
  </div>
</section>
