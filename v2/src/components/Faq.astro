---
import { faqs } from '../data/site';
---
<section class="faq wrap" id="faq" aria-labelledby="faq-title">
  <h2 class="display" id="faq-title" data-press>Questions buyers ask first.</h2>
  <div class="qs">
    {faqs.map((f, i) => (
      <details name="faq" open={i === 0}>
        <summary>{f.q}<span aria-hidden="true"></span></summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>
